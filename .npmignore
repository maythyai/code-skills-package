# .npmignore — exclude dev/runtime artifacts from the published npm tarball.
# package.json `files` is a whitelist but .npmignore is still applied to filter
# within whitelisted dirs. This keeps backup/runtime/dev files out of releases.

# Trigger backup snapshots (generated by fix-triggers / generate-triggers)
*.bak
*.pre-gen.bak

# Runtime state (per-session, never published)
.csp/
.planning/
.superpowers/
.claude/

# Third-party reference clones (dev-only, large)
开源项目参考/

# Build/analysis working dirs
docs/analysis/
